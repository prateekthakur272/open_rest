<?xml version="1.0" encoding="UTF-8"?>
<!--
  WiX v4 source for the OpenRest Windows installer (MSI).
  Build (after a release build of the Windows app), from the repository root:
    wix build packaging\windows\openrest.wxs -arch x64 ^
      -d Version=2.1.0 -d BuildDir=<abs path to build\windows\x64\runner\Release> ^
      -d IconPath=<abs path to windows\runner\resources\app_icon.ico> -o dist\OpenRest-2.1.0-windows-x64.msi
  Version must be numeric (major.minor.build); drop any pre-release suffix first.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <!-- Never change UpgradeCode: it is how Windows recognises a newer version of this same product. -->
  <Package Name="OpenRest"
           Manufacturer="Prateek Thakur"
           Version="$(Version)"
           UpgradeCode="{0B567B26-C853-4430-8791-7ECDF79249E5}"
           Scope="perMachine"
           Language="1033">
    <MajorUpgrade DowngradeErrorMessage="A newer version of OpenRest is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Icon Id="AppIcon.ico" SourceFile="$(IconPath)" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon.ico" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/prateekthakur272/open_rest" />
    <Property Id="ARPHELPLINK" Value="https://github.com/prateekthakur272/open_rest/issues" />

    <Feature Id="Main" Title="OpenRest" Level="1">
      <ComponentGroupRef Id="AppFiles" />
      <ComponentRef Id="StartMenuShortcut" />
    </Feature>

    <StandardDirectory Id="ProgramMenuFolder">
      <Component Id="StartMenuShortcut" Guid="*">
        <Shortcut Id="OpenRestShortcut"
                  Name="OpenRest"
                  Description="An open, file-based API client"
                  Target="[INSTALLFOLDER]OpenRest.exe"
                  WorkingDirectory="INSTALLFOLDER"
                  Icon="AppIcon.ico" />
        <!-- Per-machine install, so the component key lives in HKLM (an HKCU key would mix per-user and per-machine data). -->
        <RegistryValue Root="HKLM" Key="Software\OpenRest" Name="StartMenuShortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </StandardDirectory>
  </Package>

  <Fragment>
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="OpenRest" />
    </StandardDirectory>
  </Fragment>

  <!-- Every file of Flutter's release output, with its folder structure (exe, DLLs, data\...). -->
  <Fragment>
    <ComponentGroup Id="AppFiles" Directory="INSTALLFOLDER">
      <Files Include="$(BuildDir)\**" />
    </ComponentGroup>
  </Fragment>
</Wix>
